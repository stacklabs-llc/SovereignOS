# ============================================================
# SOVEREIGN OS — .gitignore
# "If it's a runtime artifact, a secret, or a log — it stays local."
# ============================================================

# ── Live Databases (NEVER commit — these are live prod data) ──
*.db
*.db-shm
*.db-wal
sovereign_now.db
sovereign_dev.db
sovereign_uat.db
sovereign_sandbox.db
sovereign_core.db
fanstack_sim.db

# ── Environment / Secrets (NEVER commit) ──
.env
.env.*
.env.auth
*.key
*.pem
*.p12
bot_config.json

# ── Python runtime ──
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
*.egg

# ── Node / Frontend build ──
node_modules/
01_Sovereign_Portal/dist/
01_Sovereign_Portal/.vite/
*.tsbuildinfo

# ── Logs & PID files (runtime artifacts) ──
*.log
*.pid
*.pid.lock
chatbots.log
chatbots_sys.log
relay.log
poller.log
sovereign_core_api.log
nuke_monitor_server.log
nuke_monitor_server.pid
nuke_74.pid
nuke_74.log
payload_sync.log
chin1_sweeper.log
auto_deploy_cle_bos.log

# ── Media vault (30TB — not for git) ──
media_vault/
media/

# ── ChromaDB vector store (regenerable) ──
chroma_db/

# ── Game session logs / exports (historical records, not source code) ──
08_FanStack/logs/
08_FanCast/logs/
# dna/dropzone/ — MIGRATED to /home/james/sovereign_inbox/ (outside git)
sovereign_inbox_link

# ── Staging / scratch outputs (not source code) ──
staging/deep_dive_vault/SANDBOX/
staging/deep_dive_vault/*.html
staging/deep_dive_vault/*.mp4
promo_staging.json

# ── OS artifacts ──
.DS_Store
Thumbs.db
desktop.ini

# ── IDE artifacts ──
.vscode/settings.json
.idea/

# ── SSL certs generated by Vite basicSsl plugin ──
*.crt
*.cert

# ── Compiled shell scripts output ──
*.tmp
*.bak
*.swp
*.zip
*.rar
*.7z
*.m4a
*.mp4
*.mkv
*.pdf
*~

# ── Unwanted heavy archives & media ──
_archive/
dna/media_OLD_BACKUP/
dna/vault/
staging/
avatars/
character_maps/
data/
logs/
game_states/
attachments/
reports/
